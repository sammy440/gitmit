{
  "name": "@gitmit/core",
  "version": "0.3.0",
  "description": "Diff analysis engine for gitmit: parse, filter, classify, summarize.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammy440/gitmit.git",
    "directory": "packages/core"
  },
  "homepage": "https://gitmit-frontend.vercel.app/docs/api",
  "bugs": {
    "url": "https://github.com/sammy440/gitmit/issues"
  },
  "keywords": [
    "git",
    "commit",
    "commit-message",
    "conventional-commits",
    "commitlint",
    "ai",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "openai": "^7.32.0",
    "zod": "^4.6.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
